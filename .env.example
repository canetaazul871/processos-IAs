# Chave da API da Anthropic (Claude). Obtenha em https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modelo da Claude a ser usado (padrão recomendado: claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# Esforço de raciocínio do modelo: low | medium | high | xhigh | max
MODEL_EFFORT=high

# Limite de tokens de saída por geração
MAX_OUTPUT_TOKENS=32000
